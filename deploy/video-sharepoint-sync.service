[Unit]
Description=Discover new SharePoint videos for Video Intelligence
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/actions-runner/_work/Video-Summarizer/Video-Summarizer/backend
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/actions-runner/_work/Video-Summarizer/Video-Summarizer/backend/venv/bin/python manage.py sync_sharepoint_folder
